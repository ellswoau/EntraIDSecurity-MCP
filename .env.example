# Copy to .env and fill in. NEVER commit the client secret or bearer key.
# Directory (tenant) ID of the Entra ID tenant.
ENTRAID_TENANT_ID=
# Application (client) ID of the app registration.
ENTRAID_CLIENT_ID=
# Client secret VALUE generated on that app registration (Certificates & secrets).
ENTRAID_CLIENT_SECRET=
ENTRAID_VERIFY_SSL=true
ENTRAID_TIMEOUT=30

# Bearer key that gates the network MCP endpoints (empty = auth disabled).
# Generate with: openssl rand -hex 32
ENTRAID_MCP_AUTH_TOKEN=

# Optional overrides (defaults shown).
# ENTRAID_BASE_URL=https://graph.microsoft.com/v1.0
# ENTRAID_AUTHORITY_HOST=https://login.microsoftonline.com
# Optional pointer to a config file written by `config init`.
# ENTRAID_CONFIG_FILE=./entraid.json